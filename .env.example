# FanXPulse Environment Variables

# ============================================
# NEXT.JS Configuration
# ============================================
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ============================================
# BLOCKCHAIN - X Layer
# ============================================

# Public RPC URLs (no secrets)
NEXT_PUBLIC_X_LAYER_RPC_MAINNET=https://rpc.xlayer.tech
NEXT_PUBLIC_X_LAYER_RPC_TESTNET=https://testrpc.xlayer.tech

# Chain IDs
NEXT_PUBLIC_X_LAYER_CHAIN_ID=196
NEXT_PUBLIC_X_LAYER_TESTNET_CHAIN_ID=1952

# ============================================
# WALLET CONNECTION
# ============================================

# Get from https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# ============================================
# REAL-TIME INDEXER
# ============================================

# Development: Connect to local services
NEXT_PUBLIC_REAL_INDEXER_URL=http://localhost:4000/graphql

# Production: Connect to deployed services
# NEXT_PUBLIC_REAL_INDEXER_URL=https://fanxpulse-graphql.railway.app/graphql

# ============================================
# SMART CONTRACTS (Optional - for advanced features)
# ============================================

# Fan Token Addresses
NEXT_PUBLIC_ARG_TOKEN_ADDRESS=0x167452bAC7bedaFC8d8eEDa356A4096321E79710
NEXT_PUBLIC_BRA_TOKEN_ADDRESS=0xe274fd08a09F24f37CbD2A5943B9A7B29503918F
NEXT_PUBLIC_ENG_TOKEN_ADDRESS=0x26f6e7dE53De649aFC44D23d0Bb1AC7D6ebEF7c7
NEXT_PUBLIC_FRA_TOKEN_ADDRESS=0x4bd3De84141309Ec83d465EE118c29d1Bb7ebD01
NEXT_PUBLIC_ESP_TOKEN_ADDRESS=0xdAC9C0Cd103B0d7E65B54c481122751A576e2746

# Uniswap V4 Hook
NEXT_PUBLIC_HOOK_ADDRESS=0x906407592cdAfE2F6DB4cC2710e1F515c416e352

# Pool Manager
# NEXT_PUBLIC_UNISWAP_V4_POOL_MANAGER_ADDRESS=0x...

# ============================================
# BACKEND SERVICES (for real-indexer)
# ============================================

# Event Listener Service
X_LAYER_RPC=https://testrpc.xlayer.tech
INDEXER_PORT=3003
INDEXER_HOST=0.0.0.0

# GraphQL Server
GRAPHQL_PORT=4000
GRAPHQL_HOST=0.0.0.0
REST_API_URL=http://localhost:3003

# Bridge contracts (if needed)
NEXT_PUBLIC_X_LAYER_BRIDGE_ADDRESS=0x

# ============================================
# WAGMI / VIEM Configuration
# ============================================
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# ============================================
# UNISWAP V4 Configuration
# ============================================
NEXT_PUBLIC_UNISWAP_V4_ROUTER_ADDRESS=0x
NEXT_PUBLIC_UNISWAP_V4_POOL_MANAGER_ADDRESS=0x
NEXT_PUBLIC_HOOK_ADDRESS=0x

# ============================================
# Fan Token Configuration
# ============================================
NEXT_PUBLIC_INITIAL_FAN_TOKENS=ARG,BRA,ENG,FRA,ESP

# ============================================
# Indexer / Data Service (Ponder)
# ============================================
NEXT_PUBLIC_PONDER_API_URL=http://localhost:42069
NEXT_PUBLIC_GRAPH_API_ENDPOINT=https://api.thegraph.com/subgraphs/name/

# ============================================
# Analytics & Monitoring
# ============================================
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_SENTRY_DSN=

# ============================================
# Development Only
# ============================================
# These variables are used only in development
DEBUG=false
VERBOSE_LOGGING=false
